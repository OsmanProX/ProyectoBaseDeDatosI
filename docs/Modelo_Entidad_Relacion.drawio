        </mxCell>
        <mxCell id="c54" value="Rectángulo = entidad · rombo = relación · min–max = participación.&#10;Las relaciones N:M se conservan sin tablas intermedias. Las hojas por área completan las relaciones de la vista general." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=18;fontColor=#556679;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="70" y="1360" width="2380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c55" value="TechCare · ER conceptual v5 (alineado al modelo relacional de 29 tablas; agrega Permiso) · N:M sin tablas puente. «Referencia» = otra aparición de la misma entidad; no es una entidad adicional. No se muestran atributos de entidades ni PK/FK." style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=17;fontColor=#556679;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="60" y="1615" width="2400" height="62" as="geometry" />
        </mxCell>
      </root>
