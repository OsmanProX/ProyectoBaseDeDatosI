        <mxCell id="c53" value="MODELO ENTIDAD–RELACIÓN CONCEPTUAL" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Helvetica;fontSize=20;fontColor=#556679;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
