@Backend_API_Proyevto_Base_de_Datos_I_HostAddress = http://localhost:5245

GET {{Backend_API_Proyevto_Base_de_Datos_I_HostAddress}}/api/test
Accept: application/json

###

GET {{Backend_API_Proyevto_Base_de_Datos_I_HostAddress}}/api/test/conexion
Accept: application/json

###
# Login con usuario de la nube (devuelve el JWT)
POST {{Backend_API_Proyevto_Base_de_Datos_I_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "usuario": "admin",
  "password": "TechCare2026!"
}

###
# Reemplazar TOKEN con el valor del login anterior
GET {{Backend_API_Proyevto_Base_de_Datos_I_HostAddress}}/api/auth/perfil
Authorization: Bearer TOKEN
Accept: application/json

###
# Clientes
GET {{Backend_API_Proyevto_Base_de_Datos_I_HostAddress}}/api/cliente
Authorization: Bearer TOKEN
Accept: application/json

###
POST {{Backend_API_Proyevto_Base_de_Datos_I_HostAddress}}/api/cliente/crear
Authorization: Bearer TOKEN
Content-Type: application/json

{
  "tipoCliente": "INDIVIDUAL",
  "nombreRazonSocial": "Prueba API",
  "nit": "CF",
  "telefono": "5555-5555",
  "correo": "prueba@api.com",
  "direccion": "Zona 1"
}

###
# Equipos
GET {{Backend_API_Proyevto_Base_de_Datos_I_HostAddress}}/api/equipo
Authorization: Bearer TOKEN
Accept: application/json

###
GET {{Backend_API_Proyevto_Base_de_Datos_I_HostAddress}}/api/equipo/tipos
Authorization: Bearer TOKEN
Accept: application/json

###
POST {{Backend_API_Proyevto_Base_de_Datos_I_HostAddress}}/api/equipo/crear
Authorization: Bearer TOKEN
